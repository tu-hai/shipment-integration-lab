{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipment-integration-lab.local/schemas/sync/error-response.schema.json",
  "title": "ErrorResponse",
  "type": "object",
  "required": ["timestamp", "traceId", "error"],
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    }
  }
}
