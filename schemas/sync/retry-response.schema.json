{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipment-integration-lab.local/schemas/sync/retry-response.schema.json",
  "title": "RetryResponse",
  "type": "object",
  "required": ["shipmentId", "status"],
  "additionalProperties": false,
  "properties": {
    "shipmentId": {
      "type": "string",
      "pattern": "^SHP-[A-Za-z0-9\\-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["RETRY_ACCEPTED"]
    }
  }
}
