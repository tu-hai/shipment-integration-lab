{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipment-integration-lab.local/schemas/async/order-created-v1.schema.json",
  "title": "OrderCreatedV1",
  "allOf": [
    {
      "$ref": "./event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "order.created.v1"
        },
        "eventVersion": {
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "producer": {
          "const": "order-service"
        },
        "payload": {
          "type": "object",
          "required": ["orderId", "customerId"],
          "additionalProperties": false,
          "properties": {
            "orderId": {
              "type": "string",
              "pattern": "^ORD-[A-Za-z0-9\\-]+$"
            },
            "customerId": {
              "type": "string",
              "pattern": "^CUS-[A-Za-z0-9\\-]+$"
            }
          }
        }
      }
    }
  ]
}
