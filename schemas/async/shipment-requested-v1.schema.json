{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipment-integration-lab.local/schemas/async/shipment-requested-v1.schema.json",
  "title": "ShipmentRequestedV1",
  "allOf": [
    {
      "$ref": "./event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "shipment.requested.v1"
        },
        "eventVersion": {
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "producer": {
          "const": "shipment-integration-service"
        },
        "payload": {
          "type": "object",
          "required": ["shipmentId", "orderId", "carrierPreference"],
          "additionalProperties": false,
          "properties": {
            "shipmentId": {
              "type": "string",
              "pattern": "^SHP-[A-Za-z0-9\\-]+$"
            },
            "orderId": {
              "type": "string",
              "pattern": "^ORD-[A-Za-z0-9\\-]+$"
            },
            "carrierPreference": {
              "type": "string",
              "enum": ["FAST_SHIP", "ECONOMY_SHIP", "STANDARD_SHIP"]
            }
          }
        }
      }
    }
  ]
}
