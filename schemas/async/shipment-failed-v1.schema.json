{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipment-integration-lab.local/schemas/async/shipment-failed-v1.schema.json",
  "title": "ShipmentFailedV1",
  "allOf": [
    {
      "$ref": "./event-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "shipment.failed.v1"
        },
        "eventVersion": {
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "producer": {
          "const": "shipment-integration-service"
        },
        "payload": {
          "type": "object",
          "required": ["shipmentId", "orderId", "errorCode", "errorMessage"],
          "additionalProperties": false,
          "properties": {
            "shipmentId": {
              "type": "string",
              "pattern": "^SHP-[A-Za-z0-9\\-]+$"
            },
            "orderId": {
              "type": "string",
              "pattern": "^ORD-[A-Za-z0-9\\-]+$"
            },
            "errorCode": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128
            },
            "errorMessage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  ]
}
